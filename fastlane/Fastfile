default_platform(:ios)

# Load gitignored secrets from repo root and/or fastlane/.
["../.env", ".env"].each do |relative|
  path = File.expand_path(relative, __dir__)
  next unless File.exist?(path)
  File.readlines(path, chomp: true).each do |line|
    next if line.empty? || line.start_with?("#")
    key, value = line.split("=", 2)
    next unless key && value
    ENV[key] = value unless ENV.key?(key) && !ENV[key].to_s.empty?
  end
end

platform :ios do
  # ---------------------------------------------------------------------------
  # Screenshots / marketing
  # ---------------------------------------------------------------------------

  desc "Capture App Store screenshots via CounterUITests"
  lane :screenshots do
    capture_screenshots(
      project: "Counter.xcodeproj",
      scheme: "Counter",
      devices: [
        "iPhone 18 Pro Max",
      ],
      languages: ["en-GB"],
      output_directory: "./screenshots",
      clear_previous_screenshots: true,
      override_status_bar: true,
      concurrent_simulators: true,
      skip_open_summary: false,
      test_without_building: false,
      only_testing: ["CounterUITests/ScreenshotTests"],
      derived_data_path: "./build/snapshot_derived_data",
    )
    frame unless env_flag("SKIP_FRAME")
  end

  desc "Apply standard Fastlane Frameit device frames + marketing titles"
  lane :frame do
    require "fileutils"

    shots = File.expand_path("../screenshots", __dir__)
    frameit_dir = File.expand_path("frameit", __dir__)

    # Frameit reads Framefile.json + *.strings next to the captures.
    FileUtils.mkdir_p(shots)
    FileUtils.cp(
      File.join(frameit_dir, "Framefile.json"),
      File.join(shots, "Framefile.json"),
    )
    Dir.glob(File.join(frameit_dir, "en-*")).each do |locale_src|
      locale = File.basename(locale_src)
      locale_dst = File.join(shots, locale)
      FileUtils.mkdir_p(locale_dst)
      Dir.glob(File.join(locale_src, "*.strings")).each do |strings|
        FileUtils.cp(strings, locale_dst)
      end
    end

    frame_screenshots(
      path: shots,
      use_platform: "IOS",
    )
  end

  desc "Copy iPhone captures into the numo-website marketing gallery"
  lane :sync_marketing do
    sh("bash", "#{File.expand_path('../scripts/sync_marketing_screenshots.sh', __dir__)}")
  end

  desc "Copy committed Watch App Store screenshots into the capture locale folder"
  lane :restore_watch_screenshots do
    require "fileutils"
    locale = ENV.fetch("SCREENSHOT_LOCALE", "en-GB")
    src = File.expand_path("watch_screenshots", __dir__)
    dst = File.expand_path("../screenshots/#{locale}", __dir__)
    FileUtils.mkdir_p(dst)
    Dir.glob(File.join(src, "*.png")).each do |path|
      FileUtils.cp(path, dst)
      UI.message("Restored Watch screenshot: #{File.basename(path)}")
    end
  end

  desc "Upload local screenshots to App Store Connect (screenshots only)"
  lane :upload_screenshots do
    restore_watch_screenshots
    upload_to_app_store(**asc_upload_params(
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
    ))
  end

  desc "Capture screenshots, sync marketing site, upload to App Store Connect"
  lane :release_screenshots do
    screenshots
    sync_marketing
    upload_screenshots
  end

  # ---------------------------------------------------------------------------
  # Version + release notes
  # ---------------------------------------------------------------------------

  desc "Write App Store What's New from CHANGELOG.md [Unreleased]"
  lane :prepare_release_notes do |options|
    cut_version = options[:cut] || ENV["CUT_CHANGELOG"]
    script = File.expand_path("../scripts/prepare_release_notes.py", __dir__)
    if cut_version && !cut_version.to_s.empty? && cut_version.to_s != "false"
      sh("python3", script, "--cut", cut_version.to_s)
    else
      sh("python3", script)
    end
  end

  desc "Bump marketing version and/or build number"
  lane :bump do |options|
    apply_version_bump(options)
    UI.success("Version #{current_marketing_version} (#{current_build_number})")
  end

  # ---------------------------------------------------------------------------
  # Full release
  # ---------------------------------------------------------------------------

  desc "Submit the current App Store Connect version for review"
  lane :submit do |options|
    api_key = load_asc_api_key
    version = options[:version] || ENV["VERSION"] || current_marketing_version
    upload_to_app_store(
      **asc_upload_params(
        api_key: api_key,
        app_version: version,
        skip_binary_upload: true,
        skip_metadata: true,
        skip_screenshots: true,
        submit_for_review: true,
        automatic_release: env_flag("AUTOMATIC_RELEASE"),
        phased_release: env_flag("PHASED_RELEASE"),
        precheck_include_in_app_purchases: false,
        submission_information: {
          add_id_info_uses_idfa: false,
          export_compliance_uses_encryption: false,
        },
      ),
    )
    UI.success("Submitted #{version} for App Review")
  end

  desc "Full release: notes, version, screenshots, marketing, build, upload"
  lane :release do |options|
    api_key = load_asc_api_key

    # 1) Version
    apply_version_bump(options)
    version = current_marketing_version
    build = next_build_number(api_key: api_key)
    increment_build_number(
      build_number: build,
      xcodeproj: "Counter.xcodeproj",
    )
    UI.important("Releasing #{version} (#{build})")

    # 2) Draft What's New from CHANGELOG (don't cut yet — wait until upload succeeds)
    prepare_release_notes
    notes = File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__))
    UI.message("What's New:\n#{notes}")

    # 3) Screenshots (framed) + marketing gallery
    unless env_flag("SKIP_SCREENSHOTS")
      screenshots
      restore_watch_screenshots
      sync_marketing unless env_flag("SKIP_MARKETING")
    end

    # 4) Archive + export for App Store Connect
    build_app(
      project: "Counter.xcodeproj",
      scheme: "Counter",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: "./ExportOptionsAppStoreExport.plist",
      output_directory: "./build",
      output_name: "Numo",
      include_bitcode: false,
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates",
    )

    # 5) Upload binary (+ framed screenshots). Skip metadata folders — App Store
    # Connect rejects creating localizations when the display name collides;
    # What's New is set via set_changelog instead.
    submit = env_flag("SUBMIT_FOR_REVIEW") || options[:submit] == true
    upload_to_app_store(
      **asc_upload_params(
        api_key: api_key,
        skip_binary_upload: false,
        skip_metadata: true,
        skip_screenshots: env_flag("SKIP_SCREENSHOTS"),
        overwrite_screenshots: !env_flag("SKIP_SCREENSHOTS"),
        submit_for_review: false, # submit after changelog is set
        automatic_release: false,
        precheck_include_in_app_purchases: false,
      ),
    )

    # What's New for this version (en-US)
    set_changelog(
      api_key: api_key,
      version: version,
      changelog: notes.strip,
    )

    if submit
      upload_to_app_store(
        **asc_upload_params(
          api_key: api_key,
          skip_binary_upload: true,
          skip_metadata: true,
          skip_screenshots: true,
          submit_for_review: true,
          automatic_release: env_flag("AUTOMATIC_RELEASE"),
          phased_release: env_flag("PHASED_RELEASE"),
          precheck_include_in_app_purchases: false,
          submission_information: {
            add_id_info_uses_idfa: false,
            export_compliance_uses_encryption: false,
          },
        ),
      )
    end

    # 6) Promote Unreleased → dated version section now that upload succeeded
    prepare_release_notes(cut: version)

    UI.success("Uploaded Numo #{version} (#{build})")
    if submit
      UI.success("Submitted for App Review")
    else
      UI.important("Not submitted for review. Re-run with SUBMIT_FOR_REVIEW=1 to submit.")
    end
  end
end

# =============================================================================
# Helpers
# =============================================================================

def env_flag(name)
  value = ENV[name].to_s.strip.downcase
  %w[1 true yes y].include?(value)
end

def current_marketing_version
  get_version_number(xcodeproj: "Counter.xcodeproj", target: "Counter")
end

def current_build_number
  get_build_number(xcodeproj: "Counter.xcodeproj")
end

def apply_version_bump(options = {})
  explicit = options[:version] || ENV["VERSION"]
  bump_type = options[:bump] || ENV["VERSION_BUMP"]

  if explicit && !explicit.to_s.empty?
    increment_version_number(
      version_number: explicit.to_s,
      xcodeproj: "Counter.xcodeproj",
    )
  elsif bump_type && !bump_type.to_s.empty? && bump_type.to_s != "none"
    unless %w[major minor patch].include?(bump_type.to_s)
      UI.user_error!("VERSION_BUMP must be major, minor, patch, or none (got #{bump_type})")
    end
    increment_version_number(
      bump_type: bump_type.to_s,
      xcodeproj: "Counter.xcodeproj",
    )
  end
end

def next_build_number(api_key:)
  if ENV["BUILD_NUMBER"] && !ENV["BUILD_NUMBER"].empty?
    return ENV["BUILD_NUMBER"].to_i
  end

  begin
    # Use the highest build across all versions so we never collide with a
    # previously uploaded build for an older marketing version.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.archgrovehouse.numo",
      initial_build_number: current_build_number.to_i,
    )
    [latest.to_i + 1, current_build_number.to_i + 1].max
  rescue => error
    UI.important("Could not read TestFlight build number (#{error.message}); bumping local build")
    current_build_number.to_i + 1
  end
end

def asc_upload_params(**overrides)
  params = {
    screenshots_path: "./screenshots",
    metadata_path: "./fastlane/metadata",
    run_precheck_before_submit: false,
    force: true,
    submit_for_review: false,
    reject_if_possible: false,
  }

  json_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  if overrides.key?(:api_key)
    params[:api_key] = overrides.delete(:api_key)
  elsif json_path && !json_path.empty?
    UI.message("Using ASC API key JSON at #{json_path}")
    params[:api_key_path] = json_path
  else
    params[:api_key] = load_asc_api_key
  end

  params.merge(overrides)
end

def load_asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] || ENV["ASC_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] || ENV["ASC_ISSUER_ID"]
  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"] || ENV["ASC_KEY_FILEPATH"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"] || ENV["ASC_KEY_CONTENT"]

  unless key_id && issuer_id && (key_filepath || key_content)
    UI.user_error!(<<~MSG)
      Missing App Store Connect API key.

      Create a key in App Store Connect → Users and Access → Integrations,
      then set either:

        export APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey.json

      or put credentials in gitignored `.env`:

        APP_STORE_CONNECT_API_KEY_KEY_ID=...
        APP_STORE_CONNECT_API_KEY_ISSUER_ID=...
        APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=/path/to/AuthKey_XXX.p8
    MSG
  end

  params = {
    key_id: key_id,
    issuer_id: issuer_id,
    duration: 1200,
    in_house: false,
  }
  if key_filepath && !key_filepath.empty?
    params[:key_filepath] = key_filepath
  else
    params[:key_content] = key_content
  end

  app_store_connect_api_key(**params)
end
